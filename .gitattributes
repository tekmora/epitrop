# Captured upstream answers: the tests split them on blank lines (\n\n), so a checkout keeps LF.
internal/sources/**/testdata/upstream/** text eol=lf

# Planted claude-local snapshot: a claudelocal test compares Fetch output to these bytes.
catalog/testdata/claude-local.snapshot.json text eol=lf

# v0.1.0 state as that release wrote it: signed canonical JSON, so the bytes stay as written.
testdata/v0.1.0/** -text

# BEGIN praetor managed attributes (praetorctl adopt)
# praetorctl audit hashes these files; keep their checkout bytes the same on every platform.
.devcontainer/Dockerfile.praetor text eol=lf
tools/figures/** text eol=lf
docs/figures/*.ts text eol=lf
docs/assets/figures/* text eol=lf
tools/figures/third_party/interfig/upstream/** -text
# END praetor managed attributes
