# Generated by Praetor from declared project commands; execution is unverified.
# Praetor ships one binary under two names; resolve whichever is installed.
-include .config/praetor/engine.mk
PRAETORCTL ?= $(shell command -v praetorctl 2>/dev/null || command -v standardsctl 2>/dev/null || echo praetorctl)
.PHONY: all verify-all compile-context compile-context-verify caveman-sources audit build test

all: build

verify-all: compile-context-verify caveman-sources audit test

compile-context:
	@$(PRAETORCTL) compile-context

compile-context-verify:
	@$(PRAETORCTL) compile-context --verify

caveman-sources:
	@$(PRAETORCTL) caveman check --configured-sources

audit:
	@$(PRAETORCTL) audit

test: build
	@exec 'go' 'test' '-v' '-race' './...'

build:
	@exec 'go' 'build' '-v' './...'

# BEGIN praetor documentation gate
.PHONY: docs-lint docs-figures
verify-all: docs-lint docs-figures
docs-lint:
	@node tools/markdownlint/verify.mjs
docs-figures:
	@node tools/figures/build.mjs check
	@node tools/figures/build.mjs sources
# END praetor documentation gate

.PHONY: schemas-refresh schemas-repin schemas-check
schemas-refresh:
	@go run -tags schemasrefresh ./tools/schemas -mode=refresh -root=. -out=.

# After Renovate moves a pin: record the new documents' digests and regenerate the fragments.
schemas-repin:
	@go run -tags schemasrefresh ./tools/schemas -mode=repin -root=. -out=.

schemas-check:
	@go run -tags schemasrefresh ./tools/schemas -mode=check -root=.

# The messages of the commits this branch adds to origin/main name no model or coding tool
# as an author. CI runs the same check on every pull request and on every push to main. A
# branch that adds no commit prints the skip line below, while CI keeps the tool's refusal of
# an empty range. Both refs resolve once, so the count and the log read the same range even
# when a fetch or a commit moves a ref while the recipe runs.
.PHONY: commit-messages
commit-messages:
	@base=$$(git rev-parse --verify --quiet 'origin/main^{commit}') \
		|| { echo "commit-messages: git rev-parse origin/main failed" >&2; exit 1; }; \
	head=$$(git rev-parse --verify --quiet 'HEAD^{commit}') \
		|| { echo "commit-messages: git rev-parse HEAD failed" >&2; exit 1; }; \
	n=$$(git rev-list --count "$$base..$$head") \
		|| { echo "commit-messages: git rev-list --count origin/main..HEAD failed" >&2; exit 1; }; \
	case "$$n" in ""|*[!0123456789]*) \
		echo "commit-messages: git rev-list --count origin/main..HEAD returned non-numeric count: $$n" >&2; exit 1 ;; \
	esac; \
	if [ "$$n" -eq 0 ]; then \
		echo "commit-messages: skipped: HEAD adds no commit to origin/main"; \
		exit 0; \
	fi; \
	f=$$(mktemp) && git log -z --format='%H%n%B' "$$base..$$head" > "$$f" \
		&& go run ./tools/commitmsg -messages="$$f"; rc=$$?; rm -f "$$f"; exit $$rc

# make verify-all runs every step of ci.yml's required go job as well, so that a green local
# gate predicts a green pull request. The Linux tests run above (test). govulncheck reads the
# vulnerability database online, as in CI. docs-drift compares this branch with origin/main;
# when the pull request body will carry a 'no docs needed: <reason>' line, put that text in a
# file and pass it as PR_BODY_FILE=<file>.
.PHONY: ci-parity gofmt-check vet tidy-check schemas-test golangci-lint gitleaks govulncheck gosec-selftest gosec docs-drift lock-advisories-selftest lock-advisories govulncheck-osvscanner selftest-interpreter
verify-all: ci-parity
ci-parity: commit-messages gofmt-check vet tidy-check schemas-test golangci-lint gitleaks govulncheck gosec-selftest gosec lock-advisories-selftest lock-advisories govulncheck-osvscanner selftest-interpreter docs-drift

GOTOOL := go tool -modfile=tools/go/go.mod

gofmt-check:
	@out=$$(gofmt -l .) && if [ -n "$$out" ]; then echo "gofmt would reformat these files:" >&2; \
		echo "$$out" >&2; exit 1; fi

vet:
	@go vet ./...
	@GOOS=darwin go vet ./...
	@GOOS=windows go vet ./...

tidy-check:
	@go mod tidy -diff

schemas-test:
	@go vet -tags schemasrefresh ./tools/schemas/
	@go test -race -tags schemasrefresh ./tools/schemas/

golangci-lint:
	@$(GOTOOL) golangci-lint run ./...

gitleaks:
	@go tool -modfile=tools/gitleaks/go.mod gitleaks git --no-banner --redact .

govulncheck:
	@$(GOTOOL) standardsctl security govuln --path=. -- $(GOTOOL) govulncheck

# gosec walks every folder under ./... itself, nested worktrees and dot folders included; the
# go command's package list is the allow-list (skips dot and underscore folders, testdata,
# nested modules, and go.mod ignore directives). The literal . prefix keeps the module root
# as . rather than an empty word the shell drops. Import-path rules forbid blanks and glob
# characters, so the unquoted expansion cannot split or glob. gosec treats only trailing ...
# as a pattern; folders holding ... mid-name are scanned as themselves. go list refuses folder
# names ending in a dot, failing the target before gosec runs.
GOSEC_PACKAGES = go list -f '.{{slice .Dir (len .Root)}}' ./...

gosec-selftest:
	@bash tools/linterselftest/selftest.sh gosec

gosec:
	@pkgs="$$($(GOSEC_PACKAGES))" && $(GOTOOL) gosec -conf .gosec.json $$pkgs

# lock-advisories scans the locked spectral CLI (tools/spectral/package-lock.json) for known
# advisories with osv-scanner, pinned in its own tool module (tools/osvscanner) because its
# dependencies conflict with the root module's. It reads osv.dev online, like govulncheck, and
# every severity fails: exit 1 on any advisory osv-scanner.toml does not exempt, and the one
# exemption it holds expires by itself. The self-test plants an old fast-uri and an expired
# exemption and must see both reported before the scan is trusted. Neither target is gated by a
# diff: the advisory database changes with no change in this repository, so a diff filter would
# hide a new advisory until someone touched the lockfile. The self-test reads osv.dev too, so it
# runs on every build as well. The scanner's own module (tools/osvscanner) is scanned by
# govulncheck-osvscanner, because the root govulncheck does not see a nested module: a finding
# at symbol level (a vulnerable function the scanner calls) fails, a module-only finding
# (required, never imported or called) is printed and passes, the root gate's rule.
OSVSCANNER := go tool -modfile=tools/osvscanner/go.mod osv-scanner

lock-advisories-selftest:
	@bash tools/linterselftest/selftest.sh osv-scanner

lock-advisories:
	@$(OSVSCANNER) scan --lockfile tools/spectral/package-lock.json --config osv-scanner.toml

govulncheck-osvscanner:
	@$(GOTOOL) govulncheck -C tools/osvscanner github.com/google/osv-scanner/v2/cmd/osv-scanner

# The self-test script reads Python through the repository launcher (.config/lefthook/python.sh,
# 3.10 floor, proven before use). A command word python or python3, or tomllib (3.11 and up),
# skips that proof. grep exit 0 = a hit = fail, 1 = no hit = pass, 2 and above = error = fail.
# INTERPRETER_SCRIPT lets the planted case point the check at a copy.
INTERPRETER_SCRIPT ?= tools/linterselftest/selftest.sh

selftest-interpreter:
	@rc=0; grep -nE -e '^[^#]*([[:space:];&|(`]|^)python3?([[:space:]]|$$)' -e '^[^#]*tomllib' \
		"$(INTERPRETER_SCRIPT)" || rc=$$?; \
	case "$$rc" in \
		1) ;; \
		0) echo "$(INTERPRETER_SCRIPT): bare python or tomllib; run Python through .config/lefthook/python.sh" >&2; exit 1 ;; \
		*) echo "$(INTERPRETER_SCRIPT): grep exit $$rc" >&2; exit 1 ;; \
	esac

docs-drift:
	@$(GOTOOL) standardsctl docs references --path=. --base=$$(git merge-base origin/main HEAD) \
		--head=HEAD $(if $(PR_BODY_FILE),--pr-body-file=$(PR_BODY_FILE))
