{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cordanallm.example/epitrop/config.schema.json",
  "title": "Epitrop configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "graph": {
      "type": "object",
      "default": {
        "max_depth": 12
      },
      "additionalProperties": false,
      "properties": {
        "max_depth": {
          "type": "integer",
          "default": 12,
          "minimum": 1,
          "maximum": 64
        }
      }
    },
    "budgets": {
      "type": "object",
      "default": {
        "default": {
          "tokens": 200000,
          "wall_clock_seconds": 3600
        },
        "platform": {
          "frontier_tokens": 0
        }
      },
      "additionalProperties": false,
      "properties": {
        "default": {
          "type": "object",
          "default": {
            "tokens": 200000,
            "wall_clock_seconds": 3600
          },
          "additionalProperties": false,
          "properties": {
            "tokens": {
              "type": "integer",
              "default": 200000,
              "minimum": 0,
              "maximum": 10000000
            },
            "wall_clock_seconds": {
              "type": "integer",
              "default": 3600,
              "minimum": 0,
              "maximum": 86400
            }
          }
        },
        "platform": {
          "type": "object",
          "default": {
            "frontier_tokens": 0
          },
          "additionalProperties": false,
          "properties": {
            "frontier_tokens": {
              "type": "integer",
              "default": 0,
              "minimum": 0,
              "maximum": 1000000000000
            }
          }
        }
      }
    },
    "jobs": {
      "type": "array",
      "default": [],
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "command",
          "log_path"
        ],
        "properties": {
          "name": {
            "type": "string",
            "default": "",
            "pattern": "^[a-z][a-z0-9-]{0,62}$"
          },
          "command": {
            "type": "array",
            "default": [],
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          },
          "log_path": {
            "type": "string",
            "default": "",
            "minLength": 1,
            "maxLength": 4096
          },
          "schedule": {
            "type": "string",
            "default": "always",
            "minLength": 0,
            "maxLength": 120
          },
          "on_event": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "task_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "status": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              }
            }
          },
          "router_alias": {
            "type": "string",
            "default": "cordana/auto",
            "pattern": "^cordana/[a-z][a-z0-9-]*$"
          },
          "max_runtime_seconds": {
            "type": "integer",
            "default": 0,
            "minimum": 0,
            "maximum": 31536000
          },
          "restart": {
            "type": "object",
            "default": {
              "policy": "never",
              "max_restarts": 0,
              "backoff_seconds": 0
            },
            "additionalProperties": false,
            "properties": {
              "policy": {
                "type": "string",
                "default": "never",
                "enum": [
                  "never",
                  "on-failure",
                  "always"
                ]
              },
              "max_restarts": {
                "type": "integer",
                "default": 0,
                "minimum": 0,
                "maximum": 32
              },
              "backoff_seconds": {
                "type": "integer",
                "default": 0,
                "minimum": 0,
                "maximum": 3600
              }
            }
          },
          "stop": {
            "type": "object",
            "default": {
              "signal": "TERM",
              "grace_seconds": 0
            },
            "additionalProperties": false,
            "properties": {
              "signal": {
                "type": "string",
                "default": "TERM",
                "enum": [
                  "TERM",
                  "INT",
                  "HUP"
                ]
              },
              "grace_seconds": {
                "type": "integer",
                "default": 0,
                "minimum": 0,
                "maximum": 300
              }
            }
          },
          "heartbeat": {
            "type": "object",
            "default": {
              "max_age_seconds": 0
            },
            "additionalProperties": false,
            "properties": {
              "max_age_seconds": {
                "type": "integer",
                "default": 0,
                "minimum": 0,
                "maximum": 86400
              }
            }
          },
          "sandbox": {
            "type": "object",
            "default": {
              "mode": "enforce",
              "reason": "",
              "workspace": "",
              "inputs": [],
              "read_only": [],
              "env_allow": [],
              "network": "none",
              "destinations": [],
              "memory_max": "2G",
              "memory_high": "",
              "cpu_weight": 100,
              "tasks_max": 512
            },
            "additionalProperties": false,
            "properties": {
              "mode": {
                "type": "string",
                "default": "enforce",
                "enum": [
                  "enforce",
                  "off"
                ]
              },
              "reason": {
                "type": "string",
                "default": "",
                "maxLength": 512
              },
              "workspace": {
                "type": "string",
                "default": "",
                "maxLength": 4096
              },
              "inputs": {
                "type": "array",
                "default": [],
                "maxItems": 32,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                }
              },
              "read_only": {
                "type": "array",
                "default": [],
                "maxItems": 32,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096,
                  "pattern": "^[^/]"
                }
              },
              "env_allow": {
                "type": "array",
                "default": [],
                "maxItems": 64,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[A-Z_][A-Z0-9_]*$"
                }
              },
              "network": {
                "type": "string",
                "default": "none",
                "enum": [
                  "none",
                  "egress",
                  "proxy"
                ]
              },
              "destinations": {
                "type": "array",
                "default": [],
                "maxItems": 16,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 261
                }
              },
              "memory_max": {
                "type": "string",
                "default": "2G",
                "pattern": "^[1-9][0-9]*[KMGT]?$"
              },
              "memory_high": {
                "type": "string",
                "default": "",
                "pattern": "^([1-9][0-9]*[KMGT]?)?$"
              },
              "cpu_weight": {
                "type": "integer",
                "default": 100,
                "minimum": 1,
                "maximum": 10000
              },
              "tasks_max": {
                "type": "integer",
                "default": 512,
                "minimum": 16,
                "maximum": 32768
              },
              "home": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "source",
                  "env"
                ],
                "properties": {
                  "source": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "env": {
                    "type": "string",
                    "pattern": "^[A-Z_][A-Z0-9_]*$"
                  },
                  "copy": {
                    "type": "array",
                    "default": [],
                    "maxItems": 8,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "file",
                        "sha256"
                      ],
                      "properties": {
                        "file": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128
                        },
                        "sha256": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{64}$"
                        }
                      }
                    }
                  },
                  "bind": {
                    "type": "array",
                    "default": [],
                    "maxItems": 8,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "file"
                      ],
                      "properties": {
                        "file": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128
                        },
                        "jwt": {
                          "type": "string",
                          "default": "",
                          "maxLength": 520
                        },
                        "expires_ms": {
                          "type": "string",
                          "default": "",
                          "maxLength": 520
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "watches": {
      "type": "array",
      "default": [],
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "trigger",
          "router_alias"
        ],
        "properties": {
          "name": {
            "type": "string",
            "default": "",
            "pattern": "^[a-z][a-z0-9-]{0,62}$"
          },
          "trigger": {
            "type": "string",
            "default": "",
            "minLength": 1,
            "maxLength": 120
          },
          "router_alias": {
            "type": "string",
            "default": "cordana/auto",
            "pattern": "^cordana/[a-z][a-z0-9-]*$"
          }
        }
      }
    },
    "router": {
      "type": "object",
      "default": {
        "aliases": [
          "cordana/auto"
        ]
      },
      "additionalProperties": false,
      "properties": {
        "aliases": {
          "type": "array",
          "default": [
            "cordana/auto"
          ],
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^cordana/[a-z][a-z0-9-]*$"
          }
        }
      }
    },
    "admission": {
      "type": "object",
      "default": {
        "probe": {
          "timeout_seconds": 30,
          "interval_seconds": 5,
          "ready_threshold": 2
        }
      },
      "additionalProperties": false,
      "properties": {
        "probe": {
          "type": "object",
          "default": {
            "timeout_seconds": 30,
            "interval_seconds": 5,
            "ready_threshold": 2
          },
          "additionalProperties": false,
          "properties": {
            "timeout_seconds": {
              "type": "integer",
              "default": 30,
              "minimum": 1,
              "maximum": 300
            },
            "interval_seconds": {
              "type": "integer",
              "default": 5,
              "minimum": 1,
              "maximum": 60
            },
            "ready_threshold": {
              "type": "integer",
              "default": 2,
              "minimum": 1,
              "maximum": 10
            }
          }
        }
      }
    },
    "event_log": {
      "type": "object",
      "default": {
        "dir": ".epitrop",
        "signing_key_path": "",
        "public_key": "",
        "lock_timeout_seconds": 5,
        "max_replay_records": 100000,
        "git": {
          "enabled": false,
          "ref": "refs/epitrop/events",
          "author_name": "",
          "author_email": "",
          "timeout_seconds": 30,
          "compact": false
        }
      },
      "additionalProperties": false,
      "properties": {
        "dir": {
          "type": "string",
          "default": ".epitrop",
          "minLength": 1,
          "maxLength": 4096
        },
        "signing_key_path": {
          "type": "string",
          "default": "",
          "maxLength": 4096
        },
        "public_key": {
          "type": "string",
          "default": "",
          "pattern": "^$|^[0-9a-fA-F]{64}$"
        },
        "lock_timeout_seconds": {
          "type": "integer",
          "default": 5,
          "minimum": 1,
          "maximum": 300
        },
        "max_replay_records": {
          "type": "integer",
          "default": 100000,
          "minimum": 1,
          "maximum": 1000000
        },
        "git": {
          "type": "object",
          "default": {
            "enabled": false,
            "ref": "refs/epitrop/events",
            "author_name": "",
            "author_email": "",
            "timeout_seconds": 30,
            "compact": false
          },
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "ref": {
              "type": "string",
              "default": "refs/epitrop/events",
              "pattern": "^refs/[A-Za-z0-9._/-]+$",
              "maxLength": 255
            },
            "author_name": {
              "type": "string",
              "default": "",
              "pattern": "^[^<>\\x00-\\x1f\\x7f]*$",
              "maxLength": 256
            },
            "author_email": {
              "type": "string",
              "default": "",
              "pattern": "^[^<>\\x00-\\x1f\\x7f]*$",
              "maxLength": 256
            },
            "timeout_seconds": {
              "type": "integer",
              "default": 30,
              "minimum": 1,
              "maximum": 300
            },
            "compact": {
              "type": "boolean",
              "default": false
            }
          }
        }
      }
    },
    "release_watch": {
      "type": "object",
      "default": {
        "state_dir": "",
        "rate_limit_floor": 100,
        "max_actions_per_run": 12,
        "per_source_cap": 3,
        "routes": []
      },
      "additionalProperties": false,
      "properties": {
        "state_dir": {
          "type": "string",
          "default": "",
          "maxLength": 4096
        },
        "rate_limit_floor": {
          "type": "integer",
          "default": 100,
          "minimum": 0,
          "maximum": 100000
        },
        "max_actions_per_run": {
          "type": "integer",
          "default": 12,
          "minimum": 1,
          "maximum": 100
        },
        "per_source_cap": {
          "type": "integer",
          "default": 3,
          "minimum": 1,
          "maximum": 20
        },
        "routes": {
          "type": "array",
          "default": [],
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "sources",
              "sinks"
            ],
            "properties": {
              "name": {
                "type": "string",
                "default": "",
                "pattern": "^[a-z][a-z0-9-]{0,62}$"
              },
              "sources": {
                "type": "array",
                "default": [],
                "minItems": 1,
                "maxItems": 16,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "github": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
                    },
                    "huggingface_org": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_.-]+$"
                    }
                  }
                }
              },
              "sinks": {
                "type": "array",
                "default": [],
                "minItems": 1,
                "maxItems": 4,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "github_issue": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "repo"
                      ],
                      "properties": {
                        "repo": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
                        },
                        "labels": {
                          "type": "array",
                          "default": [],
                          "maxItems": 8,
                          "items": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 64
                          }
                        }
                      }
                    },
                    "ntfy": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "topic"
                      ],
                      "properties": {
                        "topic": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9_.-]+$"
                        },
                        "priority": {
                          "type": "integer",
                          "default": 3,
                          "minimum": 1,
                          "maximum": 5
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "server": {
      "type": "object",
      "default": {
        "transport": "stdio",
        "listen": "127.0.0.1:8899",
        "allow_mutations": false
      },
      "additionalProperties": false,
      "properties": {
        "transport": {
          "type": "string",
          "default": "stdio",
          "enum": [
            "stdio",
            "http"
          ]
        },
        "listen": {
          "type": "string",
          "default": "127.0.0.1:8899",
          "minLength": 1,
          "maxLength": 255
        },
        "allow_mutations": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "broker": {
      "type": "object",
      "default": {
        "queue_capacity": 64,
        "dead_letter": {
          "capacity": 64,
          "fallback": "real-failure",
          "classes": []
        }
      },
      "additionalProperties": false,
      "properties": {
        "queue_capacity": {
          "type": "integer",
          "default": 64,
          "minimum": 1,
          "maximum": 4096
        },
        "dead_letter": {
          "type": "object",
          "default": {
            "capacity": 64,
            "fallback": "real-failure",
            "classes": []
          },
          "additionalProperties": false,
          "properties": {
            "capacity": {
              "type": "integer",
              "default": 64,
              "minimum": 1,
              "maximum": 4096
            },
            "fallback": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,62}$",
              "default": "real-failure"
            },
            "classes": {
              "type": "array",
              "default": [],
              "maxItems": 31,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "signatures"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{0,62}$"
                  },
                  "signatures": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 16,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 512
                    }
                  },
                  "max_retries": {
                    "type": "integer",
                    "default": 0,
                    "minimum": 0,
                    "maximum": 1
                  }
                }
              }
            }
          }
        }
      }
    },
    "sandbox_input_roots": {
      "type": "array",
      "default": [],
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    }
  }
}

