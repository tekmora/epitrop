{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>plurano/horistes"
  ],
  "pip-compile": {
    "description": "tools/semgrep/requirements.txt is a uv pip compile lock with hashes: Renovate moves semgrep in requirements.in and re-locks, so every transitive pin stays inside semgrep's own ranges",
    "managerFilePatterns": [
      "/^tools/semgrep/requirements\\.txt$/"
    ]
  },
  "pip_requirements": {
    "description": "off: it bumped the lock's transitive pins one by one, past ranges that pip install --no-deps never checks (click ~=8.4.2, exceptiongroup ~=1.2.0, importlib-metadata <8.8.0)",
    "enabled": false
  },
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "OpenAI OpenAPI schema pin in the upstream schema manifest",
      "managerFilePatterns": [
        "/^internal/sources/upstream-schemas\\.json$/"
      ],
      "matchStrings": [
        "\"id\": \"openai-openapi\"[\\s\\S]*?\"pinned_revision\": \"(?<currentDigest>[a-f0-9]{40})\""
      ],
      "datasourceTemplate": "git-refs",
      "depNameTemplate": "openai/openai-openapi",
      "packageNameTemplate": "https://github.com/openai/openai-openapi",
      "currentValueTemplate": "main"
    },
    {
      "customType": "regex",
      "description": "LiteLLM price-map schema pin in the upstream schema manifest",
      "managerFilePatterns": [
        "/^internal/sources/upstream-schemas\\.json$/"
      ],
      "matchStrings": [
        "\"id\": \"litellm-price-map\"[\\s\\S]*?\"pinned_revision\": \"(?<currentDigest>[a-f0-9]{40})\""
      ],
      "datasourceTemplate": "git-refs",
      "depNameTemplate": "BerriAI/litellm",
      "packageNameTemplate": "https://github.com/BerriAI/litellm",
      "currentValueTemplate": "main"
    },
    {
      "customType": "regex",
      "description": "Ollama API schema pin in the upstream schema manifest",
      "managerFilePatterns": [
        "/^internal/sources/upstream-schemas\\.json$/"
      ],
      "matchStrings": [
        "\"id\": \"ollama-api\"[\\s\\S]*?\"pinned_revision\": \"(?<currentDigest>[a-f0-9]{40})\""
      ],
      "datasourceTemplate": "git-refs",
      "depNameTemplate": "ollama/ollama",
      "packageNameTemplate": "https://github.com/ollama/ollama",
      "currentValueTemplate": "main"
    },
    {
      "customType": "regex",
      "description": "Codex rate-limit schema pins in the upstream schema manifest",
      "managerFilePatterns": [
        "/^internal/sources/upstream-schemas\\.json$/"
      ],
      "matchStrings": [
        "\"id\": \"codex-rate-limit-[^\"]+\"[\\s\\S]*?\"pinned_revision\": \"(?<currentDigest>[a-f0-9]{40})\""
      ],
      "datasourceTemplate": "git-refs",
      "depNameTemplate": "openai/codex",
      "packageNameTemplate": "https://github.com/openai/codex",
      "currentValueTemplate": "main"
    },
    {
      "customType": "regex",
      "description": "LiteLLM price-map schema pin in Go source",
      "managerFilePatterns": [
        "/^internal/sources/publiccatalog/litellmprices\\.go$/"
      ],
      "matchStrings": [
        "const liteLLMPriceMapRevision = \"(?<currentDigest>[a-f0-9]{40})\""
      ],
      "datasourceTemplate": "git-refs",
      "depNameTemplate": "BerriAI/litellm",
      "packageNameTemplate": "https://github.com/BerriAI/litellm",
      "currentValueTemplate": "main"
    }
  ],
  "packageRules": [
    {
      "description": "praetor-managed files: praetorctl adopt ships their updates and praetorctl audit locks them byte for byte",
      "matchFileNames": [
        ".github/workflows/praetor-docs.yml",
        "tools/markdownlint/package.json",
        "tools/markdownlint/package-lock.json",
        "tools/markdownlint/markdownlint-cli2.yaml",
        "tools/markdownlint/verify.mjs",
        "tools/markdownlint/no-private-scratch-links.mjs",
        "tools/figures/core.mjs",
        "tools/figures/checks.mjs",
        "tools/figures/build.mjs",
        "tools/figures/types.ts",
        "tools/figures/third_party/interfig/vendor.json",
        "tools/figures/third_party/interfig/VENDOR.md",
        "tools/figures/third_party/interfig/upstream/LICENSE",
        "tools/figures/third_party/interfig/upstream/src/svg.ts",
        "tools/figures/third_party/interfig/upstream/src/geometry.ts",
        "tools/figures/third_party/interfig/upstream/src/model.ts",
        "tools/figures/player/loader.js",
        "tools/figures/player/player.js",
        "tools/figures/player/THIRD-PARTY-LICENSES.txt",
        "tools/figures/figures.css",
        "tools/figures/mkdocs_hook.py",
        "tools/figures/astro.mjs",
        "tools/figures/serve.mjs",
        "tools/figures/eslint.figures.mjs",
        "tools/figures/README.md",
        ".github/workflows/praetor-api.yml",
        "tools/apicompat/gate/main.go",
        "tools/apicompat/gate/placeholder.go",
        ".devcontainer/devcontainer.json",
        ".devcontainer/Dockerfile.praetor"
      ],
      "enabled": false
    },
    {
      "description": "the Praetor engine pin moves on purpose, as one change with the re-adoption and PRAETOR_REF in ci.yml, never as a lone module update",
      "matchManagers": [
        "gomod"
      ],
      "matchPackageNames": [
        "github.com/cordanaLLM/praetor",
        "github.com/cordanaLLM/praetor/**"
      ],
      "enabled": false
    },
    {
      "description": "golusoris is this project's own framework: a release there has passed the same maintainers' gates, so it is adopted at once and does not wait the three days",
      "matchManagers": [
        "gomod"
      ],
      "matchPackageNames": [
        "github.com/golusoris/golusoris",
        "github.com/golusoris/golusoris/**"
      ],
      "groupName": "golusoris",
      "minimumReleaseAge": null
    },
    {
      "description": "the upstream schema pins move together, as one pull request a week: each move needs one make schemas-repin commit (docs/data-sync.md). git-refs gives no release timestamp, so minimumReleaseAge cannot hold these back; the digest stays put through the week instead, and the pull request merges once the pinned commit is three days old",
      "matchManagers": [
        "custom.regex"
      ],
      "matchFileNames": [
        "internal/sources/upstream-schemas.json",
        "internal/sources/publiccatalog/litellmprices.go"
      ],
      "groupName": "upstream schema pins",
      "schedule": [
        "* 0-3 * * 1"
      ],
      "updateNotScheduled": false
    },
    {
      "description": "semgrep runs on this setup-python version in ci.yml, and semgrep 1.181.0 declares Python up to 3.14: under 3.15 its engine is killed in the self-test (tekmora/epitrop pull request 194, nine of nine runs). Lift the cap when a semgrep release lists Python 3.15",
      "matchManagers": [
        "github-actions"
      ],
      "matchDepNames": [
        "python"
      ],
      "allowedVersions": "<3.15"
    }
  ]
}
